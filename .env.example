# AcroReader server-only environment variables
# Use a dedicated AcroReader Neon database, never the vCard database.
# DATABASE_URL is the pooled Neon connection used by the Next.js runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/acroreader?sslmode=require"
# DIRECT_URL is the direct Neon connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/acroreader?sslmode=require"

# Auth.js (generate a long random secret; never commit the real value)
AUTH_SECRET="replace-with-a-long-random-secret"
